# 실행 데이터 — 저장소에 남기지 않는다
/data/
/logs/
*.jsonl
*.tsv
state.json
config.json
salt

# 현장 캡처 픽스처는 정제 후 tests/fixtures/ 에만 둔다
/captures/
!/tests/fixtures/
!/tests/fixtures/**

# 비밀
.env
.env.*
*.pem
*.key
*.p12
*.mobileconfig

# macOS / 파이썬
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 빌드된 헬퍼 앱은 설정 디렉터리에 두고 저장소에 넣지 않는다
*.app/

# 에이전트용 지침·설정 파일 — 공개 저장소에 커밋하지 않는다.
# 맨 끝에 둔다: 뒤에 오는 `!` 패턴이 이 줄들을 뒤집지 않게.
CLAUDE.md
AGENTS.md
GEMINI.md
# .local·.override 같은 접미사 변종
CLAUDE.*.md
AGENTS.*.md
GEMINI.*.md
.claude/
.cursor/
.agents/
_work/
